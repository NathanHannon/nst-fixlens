DATABASE_URL=postgresql://fixlens:fixlens@localhost:5432/fixlens
# Managed Postgres (e.g. DigitalOcean): embed the password in DATABASE_URL
# and point at the provider CA cert. DATABASE_SSL=require also enables TLS.
# DATABASE_URL=postgresql://user:pass@host:25060/db?sslmode=require
# DATABASE_SSL=require
# DATABASE_CERT=./fixlens-ca-cert.crt
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_KEY=replace-me
SPACES_SECRET=replace-me
SPACES_BUCKET=fixlens
PORT=3000
